# =============================================================================
# VT India — production environment variables
# =============================================================================
# Copy to `.env.local` for local development, or set these in your hosting
# provider's environment/secret store for production.
#
# NEVER commit a real .env file. `.gitignore` blocks `.env*` and explicitly
# re-allows only this credential-free template (`!.env.example`).
#
# Until SMTP_HOST / SMTP_USER / SMTP_PASS / MAIL_TO are all set, the contact and
# careers forms return HTTP 503 with a clear on-screen message asking the
# visitor to email info@vtindia.com directly. They never fail silently and never
# pretend to have sent.
# =============================================================================

# --- SMTP transport (REQUIRED for the forms to deliver) ----------------------
SMTP_HOST=smtp.your-provider.com

# Optional. Defaults to 587. Use 465 for implicit TLS (the app switches
# automatically when the port is 465).
SMTP_PORT=587

SMTP_USER=your-smtp-username

# Set this in your host's SECRET store, not in a file that could be committed.
SMTP_PASS=your-smtp-password

# --- Delivery addresses ------------------------------------------------------
# Where contact + career submissions are delivered.
# This is VT India's official address — do not change without instruction.
MAIL_TO=info@vtindia.com

# Optional "From" address. Many providers (and SPF/DKIM) require this to be on
# the same domain as SMTP_USER. Falls back to SMTP_USER when unset.
MAIL_FROM=website@vtindia.com
